# Copy this file to api/.env and replace the placeholder values.
# Run API and Prisma commands from the api directory.

# SQLite database URL used by the API and Prisma.
# This example uses a local development database.
DATABASE_URL="file:./example-dev.db"

# Credentials from your GitHub OAuth App, used for GitHub sign-in.
# Replace these placeholders with your own development credentials.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
