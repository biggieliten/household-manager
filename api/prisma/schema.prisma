// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider        = "prisma-client"
    output          = "../src/generated/prisma"
    previewFeatures = ["partialIndexes"]
}

datasource db {
    provider = "sqlite"
}

model Household {
    id           Int           @id @default(autoincrement())
    name         String
    accessCode   String        @unique @default(nanoid(8))
    members      Member[]
    joinRequests JoinRequest[]
    tasks        Task[]
    taskGroups   TaskGroup[]
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    deletedAt    DateTime?
}

// Better Auth models (user, session, account, verification).
// Account here is a login method (GitHub, email/password) linked to a User.
model User {
    id            String    @id
    name          String
    email         String    @unique
    emailVerified Boolean   @default(false)
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    sessions      Session[]
    accounts      Account[]
    members       Member[]
    joinRequests  JoinRequest[]
}

model JoinRequest {
    id          Int       @id @default(autoincrement())
    nickname    String
    avatar      Avatar
    household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
    householdId Int
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId      String
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@unique([userId, householdId])
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String

    @@index([userId])
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId                String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
}

model Member {
    id             Int             @id @default(autoincrement())
    nickname       String
    avatar         Avatar
    isAdmin        Boolean         @default(false)
    household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
    householdId    Int
    user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         String
    completedTasks CompletedTask[]
    memberToTasks  MemberToTask[]
    memberToTaskGroups MemberToTaskGroup[]
    pauses         Pause[]
    leftAt         DateTime?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt

    @@unique([userId, householdId])
    @@unique([householdId, avatar], where: raw("\"leftAt\" IS NULL"))
}

model Task {
    id              Int             @id @default(autoincrement())
    name            String
    description     String
    frequency       Int
    isArchived      Boolean         @default(false)
    difficultyLevel Int
    household       Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
    householdId     Int
    taskToTaskGroups TaskToTaskGroup[]
    completedTasks  CompletedTask[]
    memberToTasks   MemberToTask[]
    media           TaskMedia[]
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt
    deletedAt       DateTime?
}

// An image or voice note describing a task, stored in the database itself
model TaskMedia {
    id        Int       @id @default(autoincrement())
    kind      MediaKind
    mimeType  String
    size      Int
    data      Bytes
    task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
    taskId    Int
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // A task holds at most one image and one voice note
    @@unique([taskId, kind])
}

model TaskGroup {
    id           Int       @id @default(autoincrement())
    name         String
    intervalDays Int
    startDate    DateTime
    household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
    householdId  Int
    taskToTaskGroups TaskToTaskGroup[]
    memberToTaskGroups MemberToTaskGroup[]
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    deletedAt    DateTime?
}

model TaskToTaskGroup {
    task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
    taskId      Int
    taskGroup   TaskGroup @relation(fields: [taskGroupId], references: [id], onDelete: Cascade)
    taskGroupId Int

    @@id([taskId, taskGroupId])
}

model MemberToTaskGroup {
    member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
    memberId    Int
    taskGroup   TaskGroup @relation(fields: [taskGroupId], references: [id], onDelete: Cascade)
    taskGroupId Int

    @@id([memberId, taskGroupId])
}

model MemberToTask {
    member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
    memberId Int
    task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
    taskId   Int

    @@id([memberId, taskId])
}

model CompletedTask {
    id          Int       @id @default(autoincrement())
    member      Member    @relation(fields: [memberId], references: [id])
    memberId    Int
    task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
    taskId      Int
    completedAt DateTime
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime?
}

model Pause {
    id        Int       @id @default(autoincrement())
    member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
    memberId  Int
    startDate DateTime  @default(now())
    endDate   DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([memberId])
}

enum Avatar {
    FOX
    PIG
    FROG
    CHICKEN
    OCTOPUS
    DOLPHIN
    OWL
    UNICORN
}

enum MediaKind {
    IMAGE
    AUDIO
}
