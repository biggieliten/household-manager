{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "household-manager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tillåt $(PRODUCT_NAME) att komma åt dina bilder så att du kan lägga till en bild på en syssla.",
          "cameraPermission": "Tillåt $(PRODUCT_NAME) att använda kameran så att du kan fotografera en syssla.",
          "microphonePermission": "Tillåt $(PRODUCT_NAME) att använda mikrofonen så att du kan spela in ett röstmeddelande till en syssla."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Tillåt $(PRODUCT_NAME) att använda mikrofonen så att du kan spela in ett röstmeddelande till en syssla."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
