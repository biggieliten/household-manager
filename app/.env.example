# Copy this file to app/.env.
# EXPO_PUBLIC_ values are included in the app and must not contain secrets.

# Base URL of the API, without a trailing slash or an /api/auth suffix.
# localhost works when the app and API run on the same computer.
EXPO_PUBLIC_API_URL=http://localhost:3000

# On a physical phone, use your computer's local network IP address.
# The phone must be able to reach the API on that address.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# For the standard Android Emulator, use the host computer's alias:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Alternatively, use ADB reverse port forwarding and keep localhost:
# Run on your computer: adb reverse tcp:3000 tcp:3000
# EXPO_PUBLIC_API_URL=http://localhost:3000
# This also works with a USB-connected Android phone with USB debugging enabled.
# If multiple devices are connected, select one:
# adb -s <device-serial> reverse tcp:3000 tcp:3000
